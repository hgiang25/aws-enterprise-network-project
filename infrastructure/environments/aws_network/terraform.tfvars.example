project    = "aws-enterprise-network"
deployment = "aws"
aws_region = "ap-southeast-1"
azs        = ["ap-southeast-1a", "ap-southeast-1b"]

enable_nat_gateway = true
single_nat_gateway = true

enable_demo_service = true
demo_instance_type  = "t3.micro"

# Set true to fully migrate the Cisco remote VPN function to AWS Client VPN.
# If both certificate ARNs are empty, Terraform will generate lab certificates automatically.
enable_client_vpn                 = true
client_vpn_server_certificate_arn = ""
client_vpn_root_certificate_arn   = ""
client_vpn_cidr                   = "10.250.0.0/22"

flow_log_retention_in_days = 365